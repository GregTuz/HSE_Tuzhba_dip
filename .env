# Kafka
KAFKA_NODE_ID=0
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

# Kafka UI
KAFKA_UI_PORT=8085

# ClickHouse
CLICKHOUSE_PORT_HTTP=8123
CLICKHOUSE_PORT_NATIVE=9000

# Superset
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=supersecretkey123
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com

# Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_PORT=8081
AIRFLOW_SECRET_KEY=my_super_secret_key_123
AIRFLOW_EXECUTOR=LocalExecutor

# Jupyter
JUPYTER_PORT=8888
JUPYTER_TOKEN=admin

# FastAPI
FASTAPI_PORT=8000
CSV_PATH=/app/data/Financial_Transactions_15M.csv
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ALL=transactions.all
KAFKA_TOPIC_VALID=transactions.valid
KAFKA_TOPIC_INVALID=transactions.invalid